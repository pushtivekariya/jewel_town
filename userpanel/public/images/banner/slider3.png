<script>
function waitForElm(selector) {
    return new Promise(resolve => {
        if (document.querySelector(selector)) {
            return resolve(document.querySelector(selector));
        }
        const observer = new MutationObserver(mutations => {
            if (document.querySelector(selector)) {
                resolve(document.querySelector(selector));
                observer.disconnect();
            }
        });
        observer.observe(document.body, {
            childList: true,
            subtree: true
        });
    });
};

waitForElm(".fade.modal").then(elem => {
if(window.location.toString().includes("shop")){
    document.querySelector('.fade.modal.show').classList.add('PLP');
}
})
waitForElm(".bap_main").then(elem => {
document.querySelector('.bookNAppEmail').placeholder='Email*';
document.querySelector('.bookNAText').textContent='Submit';
});
