	<script type="text/javascript">
		var brandCode = 'zo-';
		var adobeDigitalData = {};
		adobeDigitalData.page = {};
		adobeDigitalData.page.pageInfo = {};
		adobeDigitalData.page.category = {};
		adobeDigitalData.page.attributes = {};
		adobeDigitalData.page.pageInfo.section = "";
		adobeDigitalData.page.pageInfo.prodCatL0 = "";
		adobeDigitalData.account = {};
		adobeDigitalData.account.info = {};
			var cookieUserType = "userType";
			var cookieName = "CustID";
			var mobileCookieName = "mobilenumber";
			var userInfoFromCookie = "";
			var userType = "";
			var mobileNumber = "";
			//TataNeu
			var custHashcookieName = "customerHash";
			var customerIdHash = "";
			for (var i = 0; i < ca.length; i++) {
				var c = ca[i].trim();
				//Get cookie value for CustID
				if (c.indexOf(cookieName) === 0) {
					userInfoFromCookie = c.substring(
						cookieName.length + 1, c.length);
				}
				//Get cookie value for userType
				if (c.indexOf(cookieUserType) === 0) {
					userType = c.substring(
						cookieUserType.length + 1, c.length);
				}
				//Get cookie value for mobile number
				if (c.indexOf(mobileCookieName) === 0) {
					mobileNumber = c.substring(
						mobileCookieName.length + 1, c.length);
				}
				//Get cookie value for customerHash
				if (c.indexOf(custHashcookieName) === 0) {
					customerIdHash = c.substring(
						custHashcookieName.length + 1, c.length);
				}
			}
			if (userType != "" && userType == "R") {
				adobeDigitalData.account.info.custID = userInfoFromCookie;
				adobeDigitalData.account.info.phone = mobileNumber;
				adobeDigitalData.account.info.loginStatus = "Logged In";
				if (customerIdHash != "" && customerIdHash.length > 0) {
					adobeDigitalData.account.info.customeridhash = customerIdHash;
				}
			} else {
				adobeDigitalData.account.info.loginStatus = "Anonymous";
			}
			var url = window.location.href;
			var res = "";
			if (url.indexOf("shop/") > 0) {
				res = url.substring(url.indexOf("shop/") + 5, url.length);
				if (res.indexOf("/") != -1) {
					res = res.substring(0, res.indexOf("/"));
				} else if (res.indexOf("?") != -1) {
					res = res.substring(0, res.indexOf("?"));
				}
			}
		adobeDigitalData.pageInstanceID = 'zo-StoneStories-page';
		
			adobeDigitalData.page.pageInfo.pageName = "zo-StoneStories-page";
			adobeDigitalData.page.pageInfo.pageType = "StoneStories-page";
			adobeDigitalData.page.pageInfo.section = "StoneStories-page";	
			adobeDigitalData.page.category.primaryCategory = "zo-StoneStories-page";
		
			if (adobeDigitalData.page.pageInfo.pageType == 'product-listing-page') {
				adobeDigitalData.page.pageInfo.section = res;
			} else {
					if ((window.location.href).includes('/myaccount/login')) {
						adobeDigitalData.page.pageInfo.pageType = 'login-page';
						adobeDigitalData.page.pageInfo.pageName = brandCode +'login-page';
						adobeDigitalData.page.pageInfo.section = 'login-page';
					} else {
						adobeDigitalData.page.pageInfo.section = adobeDigitalData.page.pageInfo.pageType;
					}
			}
            var device;
			if (/Mobi/.test(navigator.userAgent) || /iPad/.test(navigator.userAgent)) {
				device = "M-RWD";
			} else {
				device = "WEBSITE";
			}
			var webIdentifier = device.toLowerCase();
			adobeDigitalData.page.category.websiteIdentifier = brandCode + webIdentifier;
			adobeDigitalData.page.category.platform = webIdentifier;

			if (typeof (adobeDataLayerJS) != "undefined") {
				adobeDataLayerJS.createAdobeDataLayer();
			}

	</script>

