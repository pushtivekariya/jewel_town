== \'undefined\' ? adobeDigitalData.product.productInfo.totalPriceUSD[0] : \'\';\n\tvar enPgUrl = typeof(adobeDigitalData.product.productInfo.url) !== \'undefined\' ? adobeDigitalData.product.productInfo.url[0] : \'\';\n\tvar currency = typeof(adobeDigitalData.product.productInfo.currency) !== \'undefined\' ? adobeDigitalData.product.productInfo.currency[0] : \'\';\n\tvar gender = typeof(adobeDigitalData.product.productInfo.gender) !== \'undefined\' ? adobeDigitalData.product.productInfo.gender[0] : \'\';\n\tvar enProdType = typeof(adobeDigitalData.product.productInfo.category) !== \'undefined\' ? adobeDigitalData.product.productInfo.category[0] : \'\';\n\tvar enJewType = typeof(adobeDigitalData.product.productInfo.jewelleryType) !== \'undefined\' ? adobeDigitalData.product.productInfo.jewelleryType[0] : \'\';\n\tvar enFoc = typeof(adobeDigitalData.product.productInfo.isfoc) !== \'undefined\' ? adobeDigitalData.product.productInfo.isfoc[0] : \'\';\n\tvar enBrand = typeof(adobeDigitalData.product.productInfo.brand) !== \'undefined\' ? adobeDigitalData.product.productInfo.brand[0] : \'\';\n\tvar enCatId = typeof(adobeDigitalData.product.productInfo.targetCategoryId) !== \'undefined\' ? adobeDigitalData.product.productInfo.targetCategoryId : \'\';\n\n\tvar enInventory;\n    if(adobeDigitalData.product.productInfo.stockStatus[0]=="Available"){enInventory=1;}else{enInventory=0;}\n\t\n\t\n    adobe.target.getOffer({\n\t\t"mbox": "target-recs-mbox",\n\t\t"params": {"at_property": "6a1799f9-1671-787a-024e-441fa010353a", "profile.currentProductId": enId,"profile.currentProductName": enNm, "entity.id": enId, "entity.name": enNm, "entity.inventory":enInventory, "entity.thumbnailUrl": enTmB, "entity.value": enPriceInr, "entity.pageUrl": enPgUrl, "entity.categoryId": enCatId, "entity.priceinrupee": enActualPriceInr, "entity.discpriceinrupee": enDiscPriceInr,"entity.priceindollar": enPriceUsd, "entity.discpriceindollar": enDiscPriceUsd, "entity.product_type": enProdType,"profile.