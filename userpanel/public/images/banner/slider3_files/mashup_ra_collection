 * If the screen is smaller than 480 pixels,
 * we only want to display the navigation controls.
 */
@media (max-width: 479px) {
    .wpToolbarActionBar .wpToolbarPreviewMenu,
    .wpToolbarActionBar .wpToolbarMoreMenu {
        display: none;
    }
}
